{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.25/MicrosoftTeams.schema.json",
  "manifestVersion": "1.25",
  "version": "1.0.0",
  "id": "<bot-app-id>",
  "supportsChannelFeatures": "tier1",
  "supportedChannelTypes": [
    "privateChannels",
    "sharedChannels"
  ],
  "developer": {
    "name": "Audio Summarizer",
    "websiteUrl": "https://<app-service-hostname>",
    "privacyUrl": "https://<app-service-hostname>",
    "termsOfUseUrl": "https://<app-service-hostname>"
  },
  "name": {
    "short": "Audio Summarizer",
    "full": "Audio Summarizer - Microsoft Foundry"
  },
  "description": {
    "short": "Send an audio file and get a summary.",
    "full": "Send an audio file in a chat or channel and Audio Summarizer transcribes it with Microsoft Foundry Speech to Text and replies with a concise summary generated by a Microsoft Foundry agent."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#3B5BFD",
  "validDomains": [
    "<app-service-hostname>"
  ],
  "bots": [
    {
      "botId": "<bot-app-id>",
      "scopes": [
        "personal",
        "team",
        "groupChat"
      ],
      "supportsFiles": true,
      "isNotificationOnly": false
    }
  ],
  "copilotAgents": {
    "customEngineAgents": [
      {
        "id": "<bot-app-id>",
        "type": "bot",
        "disclaimer": {
          "text": "This agent uses AI. Please verify important information."
        }
      }
    ]
  }
}
